# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Logs & local data
*.log
*.db
*.sqlite3

# IDE / editor
.vscode/
.idea/
*.swp

# OS
Thumbs.db
Desktop.ini

# CA private keys / forged certs — never commit (§3.2)
*.key
*.pem
ca/
certs/
!tests/**/*.pem
